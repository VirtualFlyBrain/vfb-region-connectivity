# VIOLATION: a synapse count annotation attached to an axiom whose relation is
# not one of the two expected region-connectivity relations
# (RO:0002110 has postsynaptic terminal in / RO:0002113 has presynaptic terminals in).
#
# Every edge is a direct ObjectPropertyAssertion, so the relation is the reified
# axiom's annotatedProperty. This also rejects any class-form axiom
# (ClassAssertion over a restriction, whose annotatedProperty would be rdf:type).
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX obo: <http://purl.obolibrary.org/obo/>

SELECT ?ax ?relation
WHERE {
  ?ax a owl:Axiom ;
      ?countProp ?value ;
      owl:annotatedProperty ?relation .
  FILTER(STRSTARTS(STR(?countProp), "http://n2o.neo/custom/"))
  FILTER(?relation != obo:RO_0002110 && ?relation != obo:RO_0002113)
}
