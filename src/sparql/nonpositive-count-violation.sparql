# VIOLATION: a synapse count annotation that is not a positive number.
# Covers every count annotation in the n2o custom namespace
# (upstream / Tbars / downstream).
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT ?ax ?prop ?value
WHERE {
  ?ax a owl:Axiom ;
      ?prop ?value .
  FILTER(STRSTARTS(STR(?prop), "http://n2o.neo/custom/"))
  FILTER(!(?value > 0))
}
