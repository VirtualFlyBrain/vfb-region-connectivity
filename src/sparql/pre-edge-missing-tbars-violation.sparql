# VIOLATION: a 'has presynaptic terminals in' (RO:0002113) edge with no
# 'Tbars' count annotation. Every edge is a direct ObjectPropertyAssertion,
# so the relation is the reified axiom's annotatedProperty.
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX custom: <http://n2o.neo/custom/>

SELECT ?ax ?neuron
WHERE {
  ?ax a owl:Axiom ;
      owl:annotatedSource ?neuron ;
      owl:annotatedProperty obo:RO_0002113 .
  FILTER NOT EXISTS { ?ax custom:Tbars ?t . }
}
