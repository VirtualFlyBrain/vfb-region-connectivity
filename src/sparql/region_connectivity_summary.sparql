# Per-dataset content summary: entity/edge counts and count-annotation totals.
# Diffed between versions to spot large shifts (e.g. a dropped ROI mapping or a
# neuprint re-export changing synapse totals).
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX custom: <http://n2o.neo/custom/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?metric ?value
WHERE {
  {
    SELECT ("dataset" AS ?metric) (STR(?d) AS ?value)
    WHERE { ?ont a owl:Ontology ; dcterms:identifier ?d . }
  } UNION {
    SELECT ("neuprint_source" AS ?metric) (STR(?s) AS ?value)
    WHERE { ?ont a owl:Ontology ; dcterms:source ?s . }
  } UNION {
    SELECT ("version" AS ?metric) (STR(?v) AS ?value)
    WHERE { ?ont a owl:Ontology ; owl:versionInfo ?v . }
  } UNION {
    # every edge is a direct ObjectPropertyAssertion, reified as an owl:Axiom:
    # relation = annotatedProperty, neuron = annotatedSource, region = annotatedTarget.
    SELECT ("neurons" AS ?metric) (COUNT(DISTINCT ?n) AS ?value)
    WHERE {
      ?ax a owl:Axiom ; owl:annotatedSource ?n ; owl:annotatedProperty ?rel .
      FILTER(?rel = obo:RO_0002110 || ?rel = obo:RO_0002113)
    }
  } UNION {
    SELECT ("regions" AS ?metric) (COUNT(DISTINCT ?reg) AS ?value)
    WHERE {
      ?ax a owl:Axiom ; owl:annotatedProperty ?rel ; owl:annotatedTarget ?reg .
      FILTER((?rel = obo:RO_0002110 || ?rel = obo:RO_0002113) && isIRI(?reg))
    }
  } UNION {
    SELECT ("postsynaptic_edges" AS ?metric) (COUNT(*) AS ?value)
    WHERE { ?ax a owl:Axiom ; owl:annotatedProperty obo:RO_0002110 . }
  } UNION {
    SELECT ("presynaptic_edges" AS ?metric) (COUNT(*) AS ?value)
    WHERE { ?ax a owl:Axiom ; owl:annotatedProperty obo:RO_0002113 . }
  } UNION {
    SELECT ("total_upstream" AS ?metric) (xsd:integer(SUM(?v)) AS ?value)
    WHERE { ?ax a owl:Axiom ; custom:upstream ?v . }
  } UNION {
    SELECT ("total_Tbars" AS ?metric) (xsd:integer(SUM(?v)) AS ?value)
    WHERE { ?ax a owl:Axiom ; custom:Tbars ?v . }
  } UNION {
    SELECT ("total_downstream" AS ?metric) (xsd:integer(SUM(?v)) AS ?value)
    WHERE { ?ax a owl:Axiom ; custom:downstream ?v . }
  }
}
ORDER BY ?metric
